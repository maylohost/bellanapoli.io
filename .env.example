# Copy to .env.local and fill with your own values. Never commit real secrets.

# Supabase (public anon key is safe for browser; service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# On-chain (factory address is public on BSCScan once deployed)
NEXT_PUBLIC_FACTORY_ADDRESS=

# Optional: football API for match data
FOOTBALL_API_KEY=

# Hardhat / deploy (never commit real private keys)
PRIVATE_KEY=
BSCSCAN_API_KEY=
